{
  "name": "trueconcept-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "TRUE CONCEPT Android APK — Capacitor wrapper for the PWA",
  "scripts": {
    "install:deps": "npm install",
    "generate:icons": "node generate-icons.mjs",
    "sync": "npx cap sync android",
    "build:web": "pnpm --filter @workspace/true-concept build",
    "build:debug": "node build.mjs --debug",
    "build:release": "node build.mjs --release",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "sharp": "^0.33.5"
  }
}
