rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      // Admin custom claim — set on admin login via the Functions API
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // ── Public reads (subjects/chapters/content) ──────────────────────────
    // These are managed by admins via the Functions API, but students read
    // them directly to populate the curriculum.
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /content/{contentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /experiments/{experimentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Content collections read directly by the client for the Practice Hub
    // (Daily Challenge + Mock Exam generators query these via the Firestore
    // SDK, not the Cloud Function). Writes remain admin-only.
    match /mcqs/{mcqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /qa/{qaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /paperSets/{setId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /papers/{paperId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Students collection (profile data) ────────────────────────────────
    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Profile is created/updated by the API server (phone-login route),
      // not by clients directly. Block direct writes from clients.
      allow write: if false;
    }

    // ── Notifications — server-emitted, students read in real-time ────────
    // Created by Functions (Admin SDK bypasses these rules) when admin adds
    // new notes/MCQs/QnA/videos. Students can ONLY read; never write.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── AI Broadcast Messages — admin content alerts (one per new content) ─
    // Written by the broadcastNewContent Cloud Function via Admin SDK.
    // All signed-in students read in real-time via useBroadcastMessages.
    match /broadcastMessages/{messageId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── AI Recommendations — per-student daily AI mentor output ───────────
    // Written by the aiMentor Cloud Function (Admin SDK) after Gemini call.
    // Each student reads only their own; clients never write directly.
    match /aiRecommendations/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Student Knowledge Profile — AI source of truth ────────────────────
    // Written by the rebuildKnowledgeProfile Firestore trigger (Admin SDK).
    // Read by the aiMentor function (Admin SDK) and optionally by clients
    // for debugging. Clients never write directly.
    match /studentKnowledgeProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Student progress (the new tracking system) ────────────────────────
    // Each student can read/write only their own progress tree.
    match /studentProgress/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow write:  if isOwner(uid);

      // All subcollections inherit the same access rules
      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      match /mcqs/{setKey} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      match /activity/{activityId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }

      // ── AI / Analytics subcollections (added with the AI Mentor system) ──
      match /chapterMastery/{chapterId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      match /questionResults/{questionId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      // Virtual-lab sim mastery — written client-side by experiment-mastery-service.
      match /experimentMastery/{experimentId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      // Practice Hub — daily challenge (one doc/day) + mock exam sessions.
      match /dailyChallenges/{dateKey} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      match /mockExamSessions/{sessionId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
      // Bookmarks — student-saved notes / MCQ sets / MCQs / Q&A for later revision.
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(uid);
        allow read:        if isAdmin();
      }
    }

    // ── Gamification ─────────────────────────────────────────────────────
    // Student XP doc + xpEvents subcollection — owner reads/writes.
    match /studentXP/{uid} {
      // Students read/write their own. Admin reads all (for admin students page).
      // Admin writes via Admin SDK (triggers) so no client write rule needed.
      allow read:  if isOwner(uid) || isSignedIn(); // admin client reads collection
      allow write: if isOwner(uid);
    }
    match /studentXP/{uid}/events/{eventId} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }
    // Weekly leaderboard — all signed-in students can read (for rankings).
    // Writes go through the Cloud Function (Admin SDK bypasses rules).
    match /weeklyLeaderboard/{weekKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /weeklyLeaderboard/{weekKey}/entries/{uid} {
      allow read:  if isSignedIn();
      allow write: if false; // only the Cloud Function writes here
    }

    // ── Default deny ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
