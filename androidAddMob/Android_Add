## 10. Add Rewarded Ad — "Watch Ad for 3 More Hours of App Use"

This is your final monetization model: every student gets **3 hours of free app usage** at a time. When their time expires, they watch a single short ad to unlock another 3 hours. This is highly profitable AND students see clear value in watching the ad.

### Step 10.1 — Create the usage timer logic

Create `artifacts/true-concept/src/lib/usage-gate.ts`:

```typescript
import { showRewarded } from "./admob";

const GATE_KEY = "trueconcept_gate_until";
const GATE_DURATION_HOURS = 3;
const GATE_DURATION_MS = GATE_DURATION_HOURS * 60 * 60 * 1000;

/** Returns the timestamp until which the user has free access. 0 = never set. */
export function getGateExpiry(): number {
  const stored = localStorage.getItem(GATE_KEY);
  return stored ? parseInt(stored, 10) : 0;
}

/** True if the user can currently use the app (gate not yet hit). */
export function isWithinGate(): boolean {
  const expiry = getGateExpiry();
  if (expiry === 0) {
    // First time user — give them 3 hours immediately, no ad
    extendGate();
    return true;
  }
  return Date.now() < expiry;
}

/** Extends the user's access by 3 more hours. */
export function extendGate() {
  const newExpiry = Date.now() + GATE_DURATION_MS;
  localStorage.setItem(GATE_KEY, newExpiry.toString());
}

/** Shows a rewarded ad. If completed fully, extends access by 3 hours. */
export async function requestMoreTime(): Promise<boolean> {
  const success = await showRewarded();
  if (success) {
    extendGate();
    return true;
  }
  return false;
}

/** Minutes remaining in current gate window. */
export function getMinutesRemaining(): number {
  const expiry = getGateExpiry();
  if (expiry === 0) return GATE_DURATION_HOURS * 60;
  const ms = expiry - Date.now();
  return Math.max(0, Math.floor(ms / 60000));
}
```

### Step 10.2 — Create the gate modal component

Create `artifacts/true-concept/src/components/UsageGate.tsx`:

```typescript
import { useState, useEffect } from "react";
import { createPortal } from "react-dom";
import { Lock, Play } from "lucide-react";
import { isWithinGate, requestMoreTime } from "@/lib/usage-gate";
import { useAuth } from "@/contexts/AuthContext";

export default function UsageGate() {
  const { user } = useAuth();
  const [blocked, setBlocked] = useState(false);
  const [loading, setLoading] = useState(false);

  // Check gate every 60 seconds while user is logged in
  useEffect(() => {
    if (!user || user.role !== "student") return;

    const check = () => setBlocked(!isWithinGate());
    check();
    const t = setInterval(check, 60_000);
    return () => clearInterval(t);
  }, [user]);

  if (!blocked) return null;

  const handleWatchAd = async () => {
    setLoading(true);
    const success = await requestMoreTime();
    setLoading(false);
    if (success) setBlocked(false);
    else alert("Please watch the full ad to continue using the app.");
  };

  return createPortal(
    <div
      className="fixed inset-0 z-[300] flex items-center justify-center p-4"
      style={{ background: "rgba(0,0,0,0.85)", backdropFilter: "blur(8px)" }}
    >
      <div
        className="liquid-card rounded-3xl p-8 max-w-sm text-center"
        style={{ border: "1px solid rgba(218,107,69,0.3)" }}
      >
        <div
          className="w-16 h-16 mx-auto mb-4 rounded-2xl flex items-center justify-center text-white"
          style={{ background: "linear-gradient(135deg, #da6b45, #b85535)" }}
        >
          <Lock className="w-8 h-8" />
        </div>
        <h2 className="font-black text-2xl text-foreground mb-2">Time's Up!</h2>
        <p className="text-sm text-muted-foreground font-semibold mb-6">
          You've used your free 3 hours. Watch a short ad to keep learning for 3 more hours.
        </p>
        <button
          onClick={handleWatchAd}
          disabled={loading}
          className="w-full py-4 rounded-2xl font-black text-white shadow-lg flex items-center justify-center gap-2 disabled:opacity-50"
          style={{ background: "linear-gradient(135deg, #da6b45, #b85535)" }}
        >
          <Play className="w-5 h-5" /> {loading ? "Loading ad…" : "Watch Ad — Get 3 More Hours"}
        </button>
        <p className="text-xs text-muted-foreground mt-4 italic">
          Your progress is saved. The ad takes about 30 seconds.
        </p>
      </div>
    </div>,
    document.body
  );
}
```

