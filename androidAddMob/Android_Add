```

Paste this content:

```typescript
import { AdMob, BannerAdSize, BannerAdPosition, AdmobConsentStatus } from "@capacitor-community/admob";

// ── Ad Unit IDs ─────────────────────────────────────────────────────────────
// During development, use Google's official test IDs (always safe to use, never get banned)
// Switch to real IDs only when ready to publish (see Step 13)

const IS_TESTING = true;  // ← change to false when going live

// Test IDs (Google's official test ad units — always show test ads)
const TEST_BANNER_ID      = "ca-app-pub-3940256099942544/6300978111";
const TEST_INTERSTITIAL_ID = "ca-app-pub-3940256099942544/1033173712";
const TEST_REWARDED_ID    = "ca-app-pub-3940256099942544/5224354917";

// Your real IDs from AdMob dashboard (Step 4)
const REAL_BANNER_ID      = "ca-app-pub-XXXXXXXXXXXXXXXX/1111111111";
const REAL_INTERSTITIAL_ID = "ca-app-pub-XXXXXXXXXXXXXXXX/2222222222";
const REAL_REWARDED_ID    = "ca-app-pub-XXXXXXXXXXXXXXXX/3333333333";

export const BANNER_ID      = IS_TESTING ? TEST_BANNER_ID      : REAL_BANNER_ID;
export const INTERSTITIAL_ID = IS_TESTING ? TEST_INTERSTITIAL_ID : REAL_INTERSTITIAL_ID;
export const REWARDED_ID    = IS_TESTING ? TEST_REWARDED_ID    : REAL_REWARDED_ID;

// ── Initialization ──────────────────────────────────────────────────────────

let initialized = false;

export async function initAdMob() {
  // Skip on web — AdMob only works on native platforms
  if (!(window as any).Capacitor?.isNativePlatform?.()) return;
  if (initialized) return;

  try {
    // Check user consent (required for users in EU/UK — safe to call everywhere)
    const consentInfo = await AdMob.requestConsentInfo();
    if (
      consentInfo.isConsentFormAvailable &&
      consentInfo.status === AdmobConsentStatus.REQUIRED
    ) {
      await AdMob.showConsentForm();
    }

    // Initialize AdMob
    await AdMob.initialize({
      testingDevices: [],   // empty = all devices treat as production (use test IDs above for safety)
      initializeForTesting: IS_TESTING,
    });

    initialized = true;
    console.info("[AdMob] Initialized");
  } catch (err) {
    console.error("[AdMob] Init failed", err);
  }
}

// ── Banner Ad ───────────────────────────────────────────────────────────────

export async function showBanner() {
  if (!(window as any).Capacitor?.isNativePlatform?.()) return;
  try {
    await AdMob.showBanner({
      adId: BANNER_ID,
      adSize: BannerAdSize.ADAPTIVE_BANNER,
      position: BannerAdPosition.BOTTOM_CENTER,
      margin: 0,
    });
  } catch (err) {
    console.error("[AdMob] Banner failed", err);
  }
}

export async function hideBanner() {
  if (!(window as any).Capacitor?.isNativePlatform?.()) return;
  try {
    await AdMob.hideBanner();
  } catch (err) {
    console.error("[AdMob] Hide banner failed", err);
  }
}

// ── Interstitial Ad ─────────────────────────────────────────────────────────

export async function showInterstitial() {
  if (!(window as any).Capacitor?.isNativePlatform?.()) return;
  try {
    // Race ad loading vs 5 sec timeout — if ad takes too long, skip it
    // (prevents long ad delays on slow networks)
    await Promise.race([
      AdMob.prepareInterstitial({ adId: INTERSTITIAL_ID }),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Ad load timeout")), 5000)
      ),
    ]);
    await AdMob.showInterstitial();
  } catch (err) {
    console.warn("[AdMob] Skipped slow ad:", err);
    // Silently skip — student isn't blocked, app continues normally
  }
}

// ── Rewarded Ad ─────────────────────────────────────────────────────────────

export async function showRewarded(): Promise<boolean> {
  if (!(window as any).Capacitor?.isNativePlatform?.()) return false;
  try {
    await AdMob.prepareRewardVideoAd({ adId: REWARDED_ID });
    const result = await AdMob.showRewardVideoAd();
    // result is the reward earned — non-null means user watched fully
    return !!result;
  } catch (err) {
    console.error("[AdMob] Rewarded failed", err);
    return false;
  }
}
```

